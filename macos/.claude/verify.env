# The same SDK as scripts/build-app.sh: the Command Line Tools' 27 SDK has no SwiftUI macro plugin.
export SDKROOT="${SDKROOT:-/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX27.2.sdk}"
# Integration tests use the real core when it has been built (docs/RELEASE.md).
if [ -x "$PWD/vendor/mihomo" ]; then
  export VEER_MIHOMO_BIN="$PWD/vendor/mihomo"
fi
