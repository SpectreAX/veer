# The same SDK as scripts/build-app.sh: the Command Line Tools' newer SDK has no SwiftUI macro plugin.
export SDKROOT="${SDKROOT:-/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk}"
# Integration tests use the real core when it has been built (docs/RELEASE.md).
if [ -x "$PWD/vendor/mihomo" ]; then
  export VEER_MIHOMO_BIN="$PWD/vendor/mihomo"
fi
