<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".VeerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Veer">
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/activity_settings"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Veer"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.dns.DnsSettingsActivity"
            android:exported="false"
            android:label="@string/activity_dns_settings"
            android:theme="@style/Theme.Veer"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.logs.LogsActivity"
            android:exported="false"
            android:label="@string/activity_logs"
            android:theme="@style/Theme.Veer"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.perapp.PerAppProxyActivity"
            android:exported="false"
            android:label="@string/activity_per_app_proxy"
            android:theme="@style/Theme.Veer"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.nodes.NodesActivity"
            android:exported="false"
            android:label="@string/activity_nodes"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Veer"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.connections.ConnectionsActivity"
            android:exported="false"
            android:label="@string/activity_connections"
            android:theme="@style/Theme.Veer"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.rules.RulesActivity"
            android:exported="false"
            android:label="@string/activity_ai_rules"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Veer"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:label="@string/activity_profiles"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Veer"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Veer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".core_mihomo.VeerVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:process=":veercore"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn_tunnel" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <provider
            android:name=".core_mihomo.ipc.CoreStateProvider"
            android:authorities="com.yamax.veer.core.state"
            android:exported="false"
            android:grantUriPermissions="false"
            android:process=":veercore" />
    </application>

</manifest>
